---
/**
 * The dark pill that shows ⌘ being tapped twice, shared by every demo on the
 * page so the trigger looks the same wherever it appears. The demo script
 * presses the key, and may replace the label as the correction goes on.
 */
---

<div
  class="flex items-center gap-3 rounded-full bg-[#17171a]/92 py-1.5 pr-4 pl-1.5 text-[#f3f2ef] shadow-lg ring-1 ring-white/10 backdrop-blur"
>
  <kbd
    class="demo-key flex size-8 items-center justify-center rounded-full border border-white/15 bg-white/10 font-sans text-base"
    data-demo-key>⌘</kbd
  >
  <span class="font-mono text-xs" data-demo-badge-label>double-tap</span>
</div>
