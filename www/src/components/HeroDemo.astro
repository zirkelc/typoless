---
import { fixCount, heroSample, type SamplePart } from '../data/hero-sample';
import DemoBadge from './DemoBadge.astro';

/**
 * The hero's animated visual: Typoless at work in a TextEdit window.
 *
 * The sentence is typed with the spell checker's squiggles, ⌘ is tapped twice,
 * the overlay sweeps the text the way the app's own overlay does, and each
 * mistake is replaced with a short green flash. The two overlay stages copy the
 * app's: an amber tint with a highlight crossing the whole block while the model
 * reads, then a green pulse on only the words that changed.
 *
 * With `scope="selection"`, part of the text is selected before the tap, and
 * only that part is scanned and fixed. A mistake outside it keeps its squiggle.
 *
 * Several demos on one page play in turn rather than at once, so the eye has
 * one thing to follow. The markup is the finished state, so without
 * JavaScript, or with reduced motion, each window simply shows the result.
 */
interface Props {
  sample?: Array<SamplePart>;
  scope?: 'field' | 'selection';
  title?: string;
  /** Read out in place of the animation. */
  description?: string;
}

const {
  sample = heroSample,
  scope = 'field',
  title = 'Untitled — Edited',
  description = 'An animation of Typoless in TextEdit: a sentence is typed with spelling mistakes, Command is pressed twice, and the mistakes are corrected in place.',
} = Astro.props;

const fixes = fixCount(sample);
const finalStatus = scope === 'selection' ? `${fixes} fixes · only the selection` : `${fixes} fixes · 0 words rewritten`;
---

<figure
  class="relative rounded-2xl border border-line bg-card shadow-[0_24px_60px_-30px_rgb(0_0_0/0.3)]"
  data-hero-demo
  data-sample={JSON.stringify(sample)}
  data-scope={scope}
  data-final-status={finalStatus}
>
  <figcaption class="sr-only">{description}</figcaption>

  <div class="relative flex items-center border-b border-line px-4 py-3" aria-hidden="true">
    <div class="flex gap-2">
      <span class="size-3 rounded-full bg-[#ff5f57]"></span>
      <span class="size-3 rounded-full bg-[#febc2e]"></span>
      <span class="size-3 rounded-full bg-[#28c840]"></span>
    </div>
    <span class="absolute inset-x-0 text-center text-xs font-medium text-muted">{title}</span>
  </div>

  <!--
    One line on a wide screen, so the scan reads as a single pass and the fixes
    land without the text reflowing. A narrow screen may still wrap it, since
    cutting the sentence off would hide half the demo.
  -->
  <div class="relative min-h-40 px-5 py-6" aria-hidden="true" data-demo-body>
    <p class="relative text-lg leading-9 whitespace-pre-wrap lg:whitespace-pre" data-demo-text>
      {
        sample.map((part) => (
          <span class:list={{ 'demo-squiggle': part.misspelled && part.typed === part.fixed }}>{part.fixed}</span>
        ))
      }
    </p>
    <div class="pointer-events-none absolute inset-0" data-demo-overlay></div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center opacity-0 transition-opacity duration-200"
      data-demo-keys
    >
      <DemoBadge />
    </div>
  </div>

  <div
    class="flex items-center justify-between border-t border-line px-5 py-3 font-mono text-xs text-faint"
    aria-hidden="true"
  >
    <span data-demo-status>{finalStatus}</span>
    <span>on device</span>
  </div>
</figure>

<script>
  import type { SamplePart } from '../data/hero-sample';
  import { fadeOut, playCorrection, reducesMotion, sleep, whenVisible } from '../scripts/correction-demo';

  /** Plays one round of a demo, and leaves the finished text standing. */
  async function play(root: HTMLElement) {
    const sample: Array<SamplePart> = JSON.parse(root.dataset.sample ?? '[]');
    const scope = root.dataset.scope === 'selection' ? 'selection' : 'field';
    const finalStatus = root.dataset.finalStatus ?? '';
    const keys = root.querySelector<HTMLElement>('[data-demo-keys]')!;
    const status = root.querySelector<HTMLElement>('[data-demo-status]')!;
    const elements = {
      body: root.querySelector<HTMLElement>('[data-demo-body]')!,
      text: root.querySelector<HTMLElement>('[data-demo-text]')!,
      overlay: root.querySelector<HTMLElement>('[data-demo-overlay]')!,
      key: root.querySelector<HTMLElement>('[data-demo-key]')!,
    };

    await fadeOut(elements);
    status.textContent = '';
    await sleep(250);

    await playCorrection(elements, {
      sample,
      scope,
      onPhase: (phase) => {
        if (phase === 'typing') status.textContent = 'Typing…';
        if (phase === 'tapping') {
          status.textContent = '⌘ ⌘';
          keys.style.opacity = '1';
        }
        if (phase === 'correcting') {
          keys.style.opacity = '0';
          status.textContent = 'Correcting…';
        }
        if (phase === 'done') status.textContent = finalStatus;
      },
    });

    await sleep(3200);
  }

  const demos = [...document.querySelectorAll<HTMLElement>('[data-hero-demo]')];

  /**
   * In turn rather than at once, so the eye has one thing to follow. Each
   * leaves its finished text standing while the next one plays.
   */
  if (!reducesMotion && demos.length > 0) {
    void (async () => {
      for (;;) {
        for (const root of demos) {
          await whenVisible();
          await play(root);
        }
      }
    })();
  }
</script>
