---
/**
 * The label, serif heading and intro that open each section.
 *
 * The heading comes in as a slot rather than a string, so a section can set one
 * word in italic, which is the page's one decorative move.
 */
interface Props {
  eyebrow: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, intro, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<div class:list={['max-w-2xl', centered && 'mx-auto text-center']}>
  <p class="font-mono text-xs font-medium tracking-[0.14em] text-accent-label uppercase">{eyebrow}</p>
  <h2 class="mt-3 font-serif text-4xl leading-[1.1] tracking-tight sm:text-5xl">
    <slot />
  </h2>
  {intro && <p class="mt-5 text-lg text-muted">{intro}</p>}
</div>
