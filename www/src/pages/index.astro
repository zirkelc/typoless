---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HeroDemo from '../components/HeroDemo.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import icon from '../assets/logo.svg';

const highlights = [
  { strong: 'Every', text: 'app on your Mac' },
  { strong: 'On-device', text: 'model' },
  { strong: 'Never', text: 'rewrites' },
  { strong: 'No', text: 'account' },
  { strong: 'Seven', text: 'languages' },
];

const steps = [
  {
    title: 'Type as you do',
    text: 'Mail, Slack, Notes, a browser. Typoless waits in the menu bar and reads nothing until you ask.',
  },
  {
    title: 'Double-tap ⌘',
    text: 'Or press a shortcut of your own. The field you are in is corrected where it is, in about a second.',
  },
  {
    title: 'Only mistakes change',
    text: 'Your wording, tone and formatting stay yours. Changed your mind? Undo, or restore it from History.',
  },
];

/** The kinds of change the app allows. It promises to touch nothing else. */
const fixes = [
  { kind: 'Spelling', before: 'teh meeting', after: 'the meeting' },
  { kind: 'Grammar', before: 'she go home', after: 'she goes home' },
  { kind: 'Punctuation', before: 'well done everyone', after: 'well done, everyone' },
  { kind: 'Capitals', before: 'i work at google', after: 'I work at Google' },
  { kind: 'Spacing', before: 'hello  world', after: 'hello world' },
];

const privacy = [
  {
    title: 'Runs on your Mac',
    text: "Apple's on-device model, or an open model you download once. Nothing is sent to a server, because there is no server.",
  },
  {
    title: 'Reads only when asked',
    text: 'Nothing is watched while you type. Typoless reads the field you are in at the moment you trigger it, and no other.',
  },
  {
    title: 'Never in the wrong place',
    text: 'Password fields are never read. Terminals and password managers are excluded from the start, and you choose the rest.',
  },
  {
    title: 'History stays in memory',
    text: 'Recent corrections are kept so you can undo them, in memory only. Quitting Typoless clears them.',
  },
];

const languages = ['English', 'German', 'French', 'Spanish', 'Italian', 'Dutch', 'Portuguese'];

const faq = [
  {
    question: 'How is this different from a grammar checker?',
    answer:
      'A grammar checker suggests, and increasingly it rewrites: other words, another tone, sometimes another language. Typoless fixes typing mistakes and small grammar slips, like “she go” for “she goes”, and stops there. Every change is checked before it is written, and anything that is not spelling, a word ending, punctuation, capitals or spacing is dropped.',
  },
  {
    question: 'Does my text leave my Mac?',
    answer:
      'No. The model runs on your Mac, and Typoless has no server to send anything to. It works without an internet connection once a downloaded model is on disk.',
  },
  {
    question: 'Which Macs does it run on?',
    answer:
      "A Mac with Apple silicon and macOS 26 or later. Apple's on-device model needs Apple Intelligence turned on; the downloadable models do not.",
  },
  {
    question: 'Which languages does it correct?',
    answer:
      'English, German, French, Spanish, Italian, Dutch and Portuguese. Each line is corrected in its own language, so a message that mixes two works too.',
  },
  {
    question: 'What if it gets something wrong?',
    answer:
      'Press ⌘Z, or open History from the menu bar and restore what was there before. From History you can also report the case, so it can be fixed.',
  },
];
---

<Layout
  title="Typoless: fixes your typos, never rewrites your words"
  description="A Mac menu bar app that corrects spelling, grammar, punctuation, capitals and spacing in any text field, on your Mac. It never rewrites what you wrote, and your text never leaves the Mac."
>
  <header class="sticky top-0 z-10 border-b border-line/70 bg-page/85 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5 font-serif text-xl font-semibold tracking-tight">
        <Image src={icon} alt="" width={28} height={28} class="size-7 rounded-[22.5%] dark:ring-1 dark:ring-white/15" loading="eager" />
        Typoless
      </a>
      <div class="hidden items-center gap-8 text-sm text-muted md:flex">
        <a href="#how" class="hover:text-ink">How it works</a>
        <a href="#fixes" class="hover:text-ink">What it fixes</a>
        <a href="#privacy" class="hover:text-ink">Privacy</a>
        <a href="#faq" class="hover:text-ink">FAQ</a>
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <a href="#download" class="rounded-lg bg-ink px-4 py-2 text-sm font-medium text-page">Get Typoless</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-20 pb-24 lg:grid-cols-2">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-xs text-muted"
        >
          <span class="size-1.5 rounded-full bg-accent"></span>
          Spell check for every app on your Mac
        </p>
        <h1 class="mt-6 font-serif text-6xl leading-[1.02] tracking-tight sm:text-7xl">
          Your words.<br />Just <em class="text-accent-ink">spelled right.</em>
        </h1>
        <p class="mt-6 max-w-lg text-lg text-muted">
          Double-tap ⌘ in any text field and Typoless fixes the spelling, grammar, punctuation, capitals and spacing. Your
          words, your tone and your formatting stay exactly as you wrote them.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3" id="download">
          <span
            class="inline-flex cursor-default items-center gap-2 rounded-xl bg-ink px-5 py-3 font-medium text-page opacity-80"
            aria-disabled="true"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
              <path
                d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.9-3-.9C6.9 7.3 5.4 8.2 4.6 9.6c-1.7 2.9-.4 7.2 1.2 9.6.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.8.8 3.1.8c1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.5-1-2.8-3.9zM14.1 5.8c.6-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.8-1.3z"
              ></path>
            </svg>
            Coming soon for Mac
          </span>
          <a href="#how" class="rounded-xl border border-line bg-card px-5 py-3 font-medium hover:border-faint">
            See how it works
          </a>
        </div>
        <p class="mt-5 font-mono text-xs text-faint">macOS 26+ · Apple silicon · Works offline</p>
      </div>

      {
        /**
         * The static before-and-after card, kept for later use. The animated
         * demo below shows the same sentence being typed and corrected. To
         * bring the card back, import it and swap the two:
         *
         * import HeroBeforeAfter from '../components/HeroBeforeAfter.astro';
         * <HeroBeforeAfter />
         */
      }
      {
        /**
         * A second demo that fixes only a selection, set aside for now. To
         * show it under this one, wrap both in a column and add it back:
         *
         * <div class="flex flex-col gap-5">
         *   <HeroDemo title="Reply to Sam — Edited" />
         *   <HeroDemo
         *     sample={selectionSample}
         *     scope="selection"
         *     title="Reply to Sam — Edited"
         *     description="A second animation: the second half of a sentence is selected before Command is pressed twice, and only the selected part is corrected. A misspelling before the selection is left as it was."
         *   />
         * </div>
         */
      }
      <HeroDemo title="Reply to Sam — Edited" />
    </section>

    <!-- Highlights -->
    <div class="border-y border-line">
      <ul
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-6 py-5 text-sm text-muted"
      >
        {
          highlights.map((item) => (
            <li>
              <strong class="font-semibold text-ink">{item.strong}</strong> {item.text}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Fixing, not rewriting -->
    <section class="bg-band py-24">
      <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
          eyebrow="Why it exists"
          align="center"
          intro="Writing tools have learned to rewrite. Ask for a spell check and you get a new sentence, in a voice that is not quite yours. Typoless does the part you actually wanted."
        >
          Fix the typos. <em class="text-accent-ink">Keep the voice.</em>
        </SectionHeading>

        <div class="mt-14 grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl border border-line bg-card p-6">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">An AI writing assistant</span>
              <span class="font-mono text-xs text-faint">rewritten</span>
            </div>
            <p class="mt-5 text-lg text-muted">
              I believe the demonstration is now prepared. Would it be possible to release it on Thursday?
            </p>
            <p class="mt-5 text-sm text-faint">Correct, polished, and no longer something you would say.</p>
          </div>
          <div class="rounded-2xl border border-accent/40 bg-card p-6 ring-4 ring-accent-soft">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">Typoless</span>
              <span class="font-mono text-xs text-accent-label">0 words rewritten</span>
            </div>
            <p class="mt-5 text-lg">I think the demo is ready, can we ship it Thursday?</p>
            <p class="mt-5 text-sm text-faint">The same message, with the mistakes taken out.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
      <SectionHeading eyebrow="How it works">
        One gesture. <em class="text-accent-ink">Then you forget it is there.</em>
      </SectionHeading>

      <ol class="mt-14 grid gap-5 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="relative overflow-hidden rounded-2xl border border-line bg-card p-6 pb-16">
              <h3 class="text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-muted">{step.text}</p>
              <span
                class="absolute right-5 -bottom-4 font-serif text-8xl text-line select-none"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- What it fixes -->
    <section id="fixes" class="scroll-mt-20 bg-band py-24">
      <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <SectionHeading
          eyebrow="What it fixes"
          intro="Every change is checked before it is written. A change that is not one of these five is dropped, so a rephrased or translated sentence never reaches your text."
        >
          Five kinds of mistake. <em class="text-accent-ink">Nothing else.</em>
        </SectionHeading>

        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card">
          {
            fixes.map((fix) => (
              <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 px-6 py-4 sm:grid-cols-[120px_1fr_auto_1fr]">
                <span class="col-span-full text-sm font-semibold sm:col-span-1">{fix.kind}</span>
                <span class="text-right font-mono text-sm whitespace-pre text-muted line-through decoration-faint">
                  {fix.before}
                </span>
                <span class="text-faint" aria-hidden="true">
                  →
                </span>
                <span class="font-mono text-sm whitespace-pre">{fix.after}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- In your apps -->
    <section class="mx-auto max-w-6xl px-6 py-24">
      <SectionHeading
        eyebrow="In your apps"
        align="center"
        intro="No window to paste into and nothing to copy back. The correction lands in the field you are typing in, with links, mentions and formatting left as they were."
      >
        It works where you <em class="text-accent-ink">already write.</em>
      </SectionHeading>

      <AppShowcase />
    </section>

    <!-- Privacy -->
    <!--
      Dark in both appearances. Using the ink colour as the background turned
      this section light in dark mode, which broke the page in the middle.
    -->
    <section
      id="privacy"
      class="scroll-mt-20 bg-[#17171a] py-24 text-[#f3f2ef] dark:border-y dark:border-line dark:bg-band"
    >
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-2xl">
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-accent uppercase">Private by design</p>
          <h2 class="mt-3 font-serif text-4xl leading-[1.1] tracking-tight sm:text-5xl">
            Your text never leaves <em class="text-accent">your Mac.</em>
          </h2>
          <p class="mt-5 text-lg opacity-70">
            No account, no cloud, no upload. Not as a setting you have to find, but because there is nowhere for
            the text to go.
          </p>
        </div>

        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            privacy.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <h3 class="font-semibold">{item.title}</h3>
                <p class="mt-2 text-sm opacity-70">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Languages -->
    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <SectionHeading
          eyebrow="Languages"
          intro="Each line is corrected in its own language, so a message that starts in German and ends in English is fixed as both."
        >
          Write in the language <em class="text-accent-ink">you think in.</em>
        </SectionHeading>

        <ul class="flex flex-wrap gap-2">
          {
            languages.map((language) => (
              <li class="rounded-full border border-line bg-card px-4 py-1.5 text-sm">{language}</li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 border-t border-line py-24">
      <div class="mx-auto max-w-3xl px-6">
        <SectionHeading eyebrow="Questions" align="center">Asked <em class="text-accent-ink">often.</em></SectionHeading>

        <div class="mt-12 divide-y divide-line border-y border-line">
          {
            faq.map((item) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium">
                  {item.question}
                  <span class="text-xl text-faint transition group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-muted">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="px-6 pb-24">
      <div class="mx-auto max-w-6xl rounded-3xl bg-band px-6 py-20 text-center">
        <Image src={icon} alt="" width={72} height={72} class="mx-auto size-18 rounded-[22.5%] dark:ring-1 dark:ring-white/15" />
        <h2 class="mt-6 font-serif text-4xl tracking-tight sm:text-5xl">
          Stop proofreading. <em class="text-accent-ink">Keep writing.</em>
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-muted">Typoless is coming to the Mac soon.</p>
        <span
          class="mt-8 inline-flex cursor-default rounded-xl bg-ink px-5 py-3 font-medium text-page opacity-80"
          aria-disabled="true"
        >
          Coming soon for Mac
        </span>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-muted sm:flex-row"
    >
      <span class="flex items-center gap-2">
        <Image src={icon} alt="" width={20} height={20} class="size-5 rounded-[22.5%] dark:ring-1 dark:ring-white/15" />
        © 2026 Typoless
      </span>
      <span class="font-mono text-xs text-faint">Made on a Mac, for the Mac.</span>
    </div>
  </footer>
</Layout>
