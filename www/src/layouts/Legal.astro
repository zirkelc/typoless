---
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import icon from '../assets/logo.svg';

/**
 * The frame for the pages that are read rather than scrolled: one column, no
 * demos, and the same header and footer as the start page so nobody has to
 * find their way back.
 */
interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <header class="border-b border-line/70">
    <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5 font-serif text-xl font-semibold tracking-tight">
        <Image src={icon} alt="" width={28} height={28} class="size-7 rounded-[22.5%] dark:ring-1 dark:ring-white/15" loading="eager" />
        Typoless
      </a>
      <a href="/" class="text-sm text-muted hover:text-ink">Back to the start page</a>
    </nav>
  </header>

  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-serif text-4xl tracking-tight">{heading}</h1>
    <p class="mt-3 font-mono text-xs text-faint">Last updated {updated}</p>

    <div class="legal mt-12">
      <slot />
    </div>
  </main>

  <SiteFooter />
</Layout>
